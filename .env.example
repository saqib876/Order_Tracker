# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Supabase â€” get from: supabase.com â†’ your project â†’ Settings â†’ API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Shopify Webhook Secret â€” get from: Shopify Admin â†’ Settings â†’ Notifications â†’ Webhooks
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret_here

# PostEx â€” public tracking API, no key needed

# Cron job secret â€” make this a long random string, e.g. openssl rand -hex 32
CRON_SECRET=your_random_cron_secret_here

# WhatsApp Cloud API â€” Meta â†’ WhatsApp â†’ API Setup
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=any_random_string_you_also_paste_in_meta

# Admin key â€” /admin/review aur /api/admin/qna-export ke liye
# Lamba random string rakhein, e.g. openssl rand -hex 32
ADMIN_KEY=your_random_admin_key_here

# Q&A matching ki hadd (0 se 1 ke darmiyan). Khali chhod dein to 0.5.
# Zyada karein = bot kam jawab dega lekin zyada sahi
# Kam karein   = bot zyada jawab dega lekin galtiyan barhengi
QNA_MATCH_THRESHOLD=0.40

# Ambiguity guard: agar do topics ke score ka farq is se kam ho to bot
# jawab NAHI deta (andaza lagane se behtar hai chup rehna).
# Khali chhod dein to 0.15. Barhayein = aur zyada mehfooz, kam jawab.
QNA_AMBIGUITY_MARGIN=0.15


# ── Tasveer parhna (OCR) ──────────────────────────────────────────────────
# Customer order ka screenshot bhejta hai — bot us mein se order number /
# confirmation number parh kar seedha tracking bhej deta hai.
# Do mein se jo bhi set ho wo chalega. Koi na ho to OCR band.
OCR_SPACE_API_KEY=
# GOOGLE_VISION_API_KEY=

# ── Message ko SAMAJHNA (AI classifier) ───────────────────────────────────
# Bot lafz ginne ke bajaye baat ka matlab pehchanta hai, aur jawab AAP KI
# EXCEL se lafz ba lafz bhejta hai. AI khud kuch nahi likhta.
#
# Teen option — jo chalu karna ho us ki key daalein aur AI_PROVIDER set karein
#   gemini   Google Gemini   — muft tier, card nahi chahiye   (default)
#   groq     Groq            — muft tier, data save nahi hota
#   claude   Claude Haiku    — paid (~$1/mahina), behtareen Roman Urdu
AI_PROVIDER=gemini
GEMINI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# AI kitna kaam kare
#   off     bilkul band — bot purane tareeqe par chalega
#   check   sirf PEHRA — kamzor milan par ghalat jawab rok deta hai.
#           Naya message nahi bhejta, is liye Meta ka kharcha sirf GHATTA hai.
#   full    pehra + bachao — jo sawaal lafzon se na mile, AI us ka sahi topic
#           dhoond kar aap ka saved jawab bhej deta hai (default)
AI_MODE=full

# Lafz wale milan ka score is se kam ho to AI se tasdeeq karwai jati hai
AI_CHECK_BELOW=0.6

# Roz itne se zyada AI call nahi (muft tier ki hifazat). Hadd paar ho to
# bot khud purane tareeqe par chala jata hai — kuch tootta nahi.
AI_MAX_PER_DAY=300

# AI ka jawab itne milliseconds mein na aaye to chhod do
AI_TIMEOUT_MS=8000

# Model khud chunna ho to (warna har provider ka default chalta hai)
# AI_MODEL=gemini-3.5-flash-lite

# ── Bot ki khamoshi ───────────────────────────────────────────────────────
# Ek customer ko bot din bhar mein itne se zyada jawab nahi dega
MAX_REPLIES_PER_DAY=4
# Aap khud customer ko jawab dein to bot itne ghante chup. CHHOTA rakhein:
# har naye manual jawab par ginti dobara shuru hoti hai, yani jab tak aap
# baat kar rahe hain bot chup hi rahega. Bara rakhne se ek chhote jawab ke
# baad poora din us customer ko tracking tak nahi jati.
HUMAN_PAUSE_HOURS=2

# Baat TEAM ke khane mein jaye (cancel, return, address, shikayat) to itne
# ghante — ye jaan boojh kar lamba hai, aisi baat ka faisla insaan karta hai.
MANUAL_PAUSE_HOURS=24
# Bilkul wohi jawab isi number ko itne GHANTE tak dobara nahi jata.
# Customer ek hi baat kai andaz mein poochta hai — jawab ek hi dafa jaye.
SAME_REPLY_HOURS=24

# Khamoshi (aap khud baat kar rahe hain) ke dauran tracking phir bhi jaye?
# 1 = haan (default). Customer order number bheje to tracking foran milti
# hai — chahe aap ne abhi abhi khud kuch likha ho.
# 0 = nahi, us number par bot bilkul chup (purana andaz)
TRACKING_DURING_PAUSE=1

# Aap ka quick reply har customer ko jata hai — wo "aap baat kar rahe hain"
# ka saboot nahi. Is liye bot itne message dekhne ke baad khamosh hota hai.
# 2 = pehla message (quick reply) nazarandaz, doosre par khamoshi (default)
# 1 = purana andaz: pehle hi message par khamoshi
HUMAN_PAUSE_MIN_MSGS=2
# Itni dair ke andar ke message ek hi guftagu ginay jate hain
HUMAN_WINDOW_MINUTES=60

# Ek hi matan itne ALAG customers ko ja chuka ho to wo quick reply mana
# jata hai — us par bot kabhi khamosh nahi hota. Bot ye khud seekhta hai.
QUICK_REPLY_MIN_CUSTOMERS=3
