# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Supabase â€” get from: supabase.com â†’ your project â†’ Settings â†’ API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Shopify Webhook Secret â€” get from: Shopify Admin â†’ Settings â†’ Notifications â†’ Webhooks
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret_here

# PostEx â€” public tracking API, no key needed

# Cron job secret â€” make this a long random string, e.g. openssl rand -hex 32
CRON_SECRET=your_random_cron_secret_here

# WhatsApp Cloud API â€” Meta â†’ WhatsApp â†’ API Setup
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=any_random_string_you_also_paste_in_meta

# Admin key â€” /admin/review aur /api/admin/qna-export ke liye
# Lamba random string rakhein, e.g. openssl rand -hex 32
ADMIN_KEY=your_random_admin_key_here

# Q&A matching ki hadd (0 se 1 ke darmiyan). Khali chhod dein to 0.5.
# Zyada karein = bot kam jawab dega lekin zyada sahi
# Kam karein   = bot zyada jawab dega lekin galtiyan barhengi
QNA_MATCH_THRESHOLD=0.40

# Ambiguity guard: agar do topics ke score ka farq is se kam ho to bot
# jawab NAHI deta (andaza lagane se behtar hai chup rehna).
# Khali chhod dein to 0.15. Barhayein = aur zyada mehfooz, kam jawab.
QNA_AMBIGUITY_MARGIN=0.15

